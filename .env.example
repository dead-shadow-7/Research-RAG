# --- Datastores (docker compose up -d) ---
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379

# --- Auth (Supabase) ---
# Supabase issues the tokens; this API only verifies them, against the public keys at
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json. Nothing secret goes here.
# Local development points at the real project: there is no auth emulator to run.
SUPABASE_URL=https://<project-ref>.supabase.co
# Documents one user may hold. Pinecone's free tier is 2 GB across the org.
MAX_DOCUMENTS_PER_USER=50

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=rag-dev
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- LLM (any OpenAI-compatible provider) ---
# Point OPENAI_BASE_URL at your provider's endpoint, including the /v1 suffix
# if it uses one. Leave it blank to talk to api.openai.com.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Required: the model id exactly as your provider names it.
OPENAI_MODEL=
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.2
# off | auto -- "off" disables the thinking pass on hybrid reasoning models
# (Qwen3, GLM, o-series). Grounded QA over retrieved text rarely benefits from it,
# and it can consume most of LLM_MAX_TOKENS. Set to "auto" to keep the provider default.
LLM_REASONING=off

# --- Embeddings (an OpenAI-compatible /embeddings endpoint) ---
# The model id exactly as your provider names it. EMBEDDING_DIM must match the Pinecone
# index, which is immutable -- changing either means a new index and a full re-index.
EMBEDDING_MODEL=baai/bge-base-en-v1.5
EMBEDDING_DIM=768
# Blank means "same provider as the chat model above". Set these only to split them.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# Texts per request, and chunks per upsert slice.
# EMBED_BATCH_SIZE=128
# INGEST_BATCH_SIZE=128

# --- Chunking / retrieval ---
CHUNK_TOKENS=380
CHUNK_OVERLAP=64
RETRIEVE_K=20
# CONTEXT_K is a ceiling, not a quota: a chunk only reaches the model if it scores
# within CONTEXT_MIN_RATIO of the best match and clears CONTEXT_MIN_SCORE. Without
# that floor, every question ships six chunks whether or not six are relevant.
CONTEXT_K=6
CONTEXT_MIN_RATIO=0.75
# Calibrated for bge-base-en-v1.5. Re-measure with tests/eval_retrieval.py if you
# change the embedding model -- this is a property of the model, not a constant.
CONTEXT_MIN_SCORE=0.50

# --- Storage / app ---
# Leave unset: the default is api/storage/uploads, derived from the package location
# rather than the working directory. A relative path here lands wherever you happened to
# start the process from, which is how you end up with two uploads trees.
# UPLOAD_DIR=
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173

# --- Optional: LangSmith tracing (very useful for debugging bad answers) ---
# app/config.py reads these and exports them to the process environment, which is where
# the LangSmith SDK looks. Both TRACING and API_KEY are needed; one alone does nothing.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=rag
# Only if your account is outside the default region, e.g. APAC:
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
