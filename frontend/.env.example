# Copy to .env.local for development. Vite inlines VITE_* at **build** time, so in
# production these are set in the Vercel project and changing one needs a redeploy,
# not a restart.

# Supabase project settings -> Data API. The anon key is meant to be public; it is in
# the browser bundle by design. Never put the service-role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Leave unset in development: Vite proxies /api to localhost:8000 (see vite.config.js).
# In production set it to the API host, e.g. https://api.yourdomain.com/api
# VITE_API_BASE=
