# Secrets must never reach the build context -- an image layer is not a private place.
.env
.env.*
!.env.example

# The local virtualenv is Windows-built and hundreds of MB; the image builds its own.
.venv/
venv/

# Runtime state: uploaded files belong in the volume, not in a layer.
storage/

# Build and test artefacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
tests/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
