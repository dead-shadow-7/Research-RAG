# Environment
.env
.env.local
.env.production
!.env.production.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Runtime storage (uploaded files)
api/storage/uploads/*
!api/storage/uploads/.gitkeep
# A relative UPLOAD_DIR resolves against the process's working directory, so running
# uvicorn from the repo root drops a second uploads tree here. Never commit one: these
# are whatever documents somebody uploaded.
/storage/

# Node
node_modules/
frontend/dist/
frontend/.vite/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
