# Copy to .env.production on the server and fill in. Never commit the filled version.
#   cp .env.production.example .env.production

# --- TLS / routing ---
# Must already resolve to this host, or Caddy cannot get a certificate.
API_DOMAIN=api.yourdomain.com

# --- Supabase ---
# Session-mode pooler (port 5432), NOT the direct connection: direct is IPv6-only
# unless you buy the IPv4 add-on, and a default EC2 instance is IPv4.
# Note the username is postgres.<project-ref>. URL-encode the password if it contains
# any of  @ : / ? # [ ] %
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?ssl=require

# --- Queue (runs on this host, see docker-compose.prod.yml) ---
REDIS_URL=redis://redis:6379

# --- Auth (Supabase) ---
# The same project as DATABASE_URL above. Verification uses the public JWKS endpoint
# derived from this URL, so there is no secret to leak here.
SUPABASE_URL=https://<project-ref>.supabase.co
MAX_DOCUMENTS_PER_USER=20
# Per-user rate limits, counted in-process. Sign-up is open and unverified, so without
# these one account can spend the provider budget without limit. 0 disables a limit.
CHAT_PER_MINUTE=12
CHAT_PER_DAY=300
UPLOADS_PER_HOUR=30

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=rag-prod
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- LLM (any OpenAI-compatible endpoint) ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.2
LLM_REASONING=off

# --- Embeddings (an OpenAI-compatible /embeddings endpoint) ---
# EMBEDDING_DIM must match the Pinecone index; startup asserts it.
EMBEDDING_MODEL=baai/bge-base-en-v1.5
EMBEDDING_DIM=768
# Blank means "same provider as OPENAI_BASE_URL / OPENAI_API_KEY above".
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
UPLOAD_DIR=/app/storage/uploads

# --- Retrieval ---
# CONTEXT_MIN_SCORE is calibrated for bge-base. Re-measure with tests/eval_retrieval.py
# if you change the embedding model; do not carry this number across models.
RETRIEVE_K=20
CONTEXT_K=6
CONTEXT_MIN_RATIO=0.75
CONTEXT_MIN_SCORE=0.50

# --- App ---
MAX_UPLOAD_MB=8
# Your Vercel production domain(s), comma separated.
CORS_ORIGINS=https://yourapp.vercel.app
# Vercel gives each preview deploy its own hostname; match them by pattern.
CORS_ORIGIN_REGEX=https://yourapp-.*\.vercel\.app
